# Local Qwen configuration. Keep disabled until the model dependencies and
# hardware are ready; enabling it may download a large model.
QWEN_LOCAL_ENABLED=false
QWEN_MODEL=Qwen/Qwen2.5-14B-Instruct

# Gemini Lite is used on this laptop because it cannot practically load Qwen14B.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_MODEL=gemini-3.6-flash
